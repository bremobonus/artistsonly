# ---- site (Vercel project, root directory: site) ----
AKIRA_DASHBOARD_KEY=        # long random string; /akira?k=<this> unlocks the operations room
AKIRA_INGEST_SECRET=        # long random string; devices, shortcuts and the mail worker send it as Bearer
GITHUB_TOKEN=               # fine-grained PAT, this repo only, Contents: read/write (site lands events as commits)
AKIRA_REPO=bremobonus/artistsonly
AKIRA_BRANCH=main
# AKIRA_LOCAL_BRAIN=1       # local dev only: read/write ../akira/brain on disk instead of GitHub

# ---- Akira runtime (GitHub Actions secrets) ----
ANTHROPIC_API_KEY=
AKIRA_NTFY_TOPIC=           # ntfy.sh topic for push notifications (unguessable)
RESEND_API_KEY=             # outbound mail as akira@artistsonly.io
AKIRA_NOTIFY_EMAIL_TO=      # Amos's address for the daily brief
# Google (Gmail read-only + Calendar events). One OAuth client of type Desktop app in Google Cloud Console,
# Gmail API and Google Calendar API enabled; then `npm run google-auth` in akira/ once prints the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# AKIRA_MODEL=claude-opus-5 # repository variable, optional override
